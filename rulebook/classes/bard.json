        "10": [
            {
                "name": "Magical Secrets",
                "description": "You have learned to draw upon magic from any tradition. Whenever your number of prepared Bard spells increases or you replace a prepared spell on gaining a Bard level, you can choose the new spell from the Bard, Cleric, Druid, or Wizard spell list. The chosen spells count as Bard spells for you, and they must be of a level for which you have spell slots."
            }
