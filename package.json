{
  "name": "dnd-character-features-plugin",
  "version": "1.0.0",
  "description": "The DnD Character Sheet Helper is an Obsidian Plugin that brings the DnD Rulebook right inside your Digital Character Sheet.",
  "main": "index.js",
  "scripts": {
    "generate": "node generate-registry.js",
    "dev": "npm run generate && esbuild main.ts --bundle --watch --format=cjs --external:obsidian --outfile=main.js",
    "build": "npm run generate && esbuild main.ts --bundle --format=cjs --external:obsidian --outfile=main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IonasPolitis/DnD_Character_Features.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/IonasPolitis/DnD_Character_Features/issues"
  },
  "homepage": "https://github.com/IonasPolitis/DnD_Character_Features#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "crelt": "^1.0.7",
    "moment": "^2.29.4",
    "style-mod": "^4.1.3",
    "w3c-keyname": "^2.2.8"
  }
}
